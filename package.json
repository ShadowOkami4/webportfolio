{
  "name": "okami-website",
  "version": "1.0.0",
  "description": "Static personal portfolio for Okami's projects and videos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check assets/js/head.js && node --check assets/js/translations.js && node --check assets/js/script.js",
    "build:tokens": "tsx tools/build-tokens.mjs",
    "build:fonts": "node tools/build-fonts.mjs",
    "build:shapes": "node tools/build-shapes.mjs",
    "check:i18n": "node tools/check-translations.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "tsx": "^4.20.0"
  }
}
